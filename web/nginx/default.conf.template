# Portal Web do OrbitaTI: serve a SPA e faz proxy de /api para a API (mesma origem, sem CORS).
# Este arquivo é um TEMPLATE: na subida do contêiner, o entrypoint do nginx troca ${API_UPSTREAM}
# pelo valor da variável de ambiente (envsubst) e grava o resultado em /etc/nginx/conf.d/default.conf.
# Só variáveis que começam com API_ são trocadas (NGINX_ENVSUBST_FILTER no Dockerfile), para que
# variáveis do próprio nginx ($uri, $host...) nunca sejam confundidas com variáveis de ambiente.

server_tokens off;

# Id de correlação: usa o X-Request-Id do cliente se vier; senão, o $request_id gerado pelo nginx.
# A API devolve o mesmo id na resposta e o leva para o log e para o job da importação.
map $http_x_request_id $id_requisicao {
    default $http_x_request_id;
    ""      $request_id;
}

# Access log SEM a query string (bloco 10). O formato padrão grava "$request", que traz ?token=... do link
# de confirmação (/confirmar-email e /api/auth/confirmar, 24 h) e do de exportação (bloco 14, 30 dias):
# quem lesse o log teria credenciais válidas. $uri é só o caminho. O id de correlação entra no fim para
# cruzar com o log da API.
#
# upstream=<endereço> <status>: para quem a requisição foi e o que a API respondeu ("-" se não passou pela
# API). É o diagnóstico de um 502/504 agora que o error_log só registra "crit" (N5, abaixo).
#
# $caminho e não $uri: o rewrite do /api/ (abaixo) muda o $uri para "/saude", e o log perderia o "/api".
# $caminho é o $request_uri (o que o cliente pediu) cortado no "?", então continua sem a query string.
map $request_uri $caminho {
    "~^(?<sem_query>[^?]*)" $sem_query;
    default                 $request_uri;
}
log_format orbitati '$remote_addr [$time_local] "$request_method $caminho $server_protocol" $status '
                    '$body_bytes_sent $request_time "$http_user_agent" $id_requisicao '
                    'upstream=$upstream_addr $upstream_status';

# N5 (docs/pendencias-bloco-7.md): o error_log não tem formato configurável e, num erro de upstream (API
# fora, nome que não resolve), grava a linha da requisição COM a query string, e com ela o ?token= do link
# de confirmação (24 h) ou de exportação. Em "crit" esses erros (nível "error") não são gravados. O
# diagnóstico de um 502 vem do access_log (status + upstream acima) e do log da API, pelo id de correlação.
error_log /dev/stderr crit;

# DNS para achar a API, resolvido de novo a cada 10 s (API_RESOLVER: ver 16-api-resolver.envsh).
# ipv6=off: a rede do compose e a do kind são IPv4; sem isso o nginx também pede AAAA e pode tentar um
# endereço que não responde.
resolver ${API_RESOLVER} valid=10s ipv6=off;
resolver_timeout 3s;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types text/css application/javascript text/javascript application/json
           application/manifest+json image/svg+xml text/csv text/plain;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    # Substitui o access_log do nginx.conf da imagem (formato "main", com a query string).
    access_log /var/log/nginx/access.log orbitati;

    # 2m > 1 MB da API: o 413 de CSV grande vem da API, em JSON com ARQUIVO_GRANDE.
    # Com o padrão do nginx (1m), quem responderia seria o nginx, em HTML, e o Portal perderia o código.
    client_max_body_size 2m;

    include /etc/nginx/seguranca.conf;

    # Healthcheck do compose/kind. Não passa pela API: diz só se o nginx está de pé.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Rotas internas (worker -> API) nunca são alcançáveis pelo Portal. Já exigem token de serviço;
    # isto é uma camada a mais. O nginx normaliza a URL antes de comparar (%69nterno, //interno, ../),
    # então variações não escapam. Resposta no formato de erro do contrato.
    location ^~ /api/interno {
        default_type application/json;
        return 404 '{"erro":"Recurso não encontrado.","codigo":"NAO_ENCONTRADO"}';
    }

    # Proxy da API: /api/contatos?q=x -> http://API_UPSTREAM/contatos?q=x.
    # O upstream fica numa VARIÁVEL para o nginx usar o "resolver" acima (nome resolvido de novo a cada
    # 10 s; sem variável, ele resolveria uma vez só, na subida). Efeito colateral: com variável, um
    # "proxy_pass http://$x/" deixaria de trocar só o prefixo e mandaria "/" para TODA requisição. Por isso
    # o /api sai no rewrite (a query string segue sozinha) e o proxy_pass fica sem caminho.
    # No kind, API_UPSTREAM precisa do nome completo (api-contatos.orbitati.svc.cluster.local:3000): o
    # resolver do nginx não usa o "search" do /etc/resolv.conf.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # A API usa o X-Forwarded-For via trustProxy (TRUST_PROXY_SALTOS, bloco 5). Sem isso, os rate
        # limits de login e cadastro veriam todo mundo com o IP do nginx. $proxy_add_x_forwarded_for
        # ACRESCENTA o IP real no fim; com 1 salto confiável a API lê só esse último, então um
        # X-Forwarded-For forjado pelo cliente fica à esquerda e é ignorado.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $id_requisicao;
        # A importação manda até 1 MB de CSV: lê o corpo inteiro antes de abrir a conexão com a API.
        proxy_request_buffering on;
    }

    # Assets do Vite têm hash no nome: se o conteúdo muda, o nome muda. Cache de 1 ano é seguro.
    location /assets/ {
        include /etc/nginx/seguranca.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: qualquer rota do Portal (/contatos/123, /importar...) devolve o index.html e o React Router
    # decide a tela. index.html e arquivos sem hash: no-cache (revalida sempre, usa ETag) para que um
    # deploy novo apareça no próximo carregamento.
    location / {
        include /etc/nginx/seguranca.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
