# OrbitaTI: variáveis de ambiente. Copie para .env (o .env é ignorado pelo git).
#
# Os valores abaixo FUNCIONAM como estão: o CI (bloco 8) copia este arquivo para .env e sobe a stack.
# Para uso local, prefira `npm run env`, que gera um .env com senhas aleatórias (e nunca sobrescreve um .env existente).
#
# ATENÇÃO: as senhas dos papéis do banco são gravadas no PRIMEIRO boot do Postgres (db/init/01-papeis.sh).
# Trocar uma senha aqui depois disso quebra o login daquele papel até recriar o volume (ver README).
#
# Os testes rodam no host e conectam em 127.0.0.1:5432 montando a conexão com as senhas abaixo.
# As URLs usam o host "postgres", que só existe dentro da rede do Docker Compose.

# Superusuário do Postgres. Só o entrypoint da imagem usa (criar o banco e rodar db/init).
POSTGRES_PASSWORD=exemplo_postgres_troque

# Papéis do banco (regra 6 do CLAUDE.md)
#   migrador       dono dos schemas e tabelas; só roda migrações
#   api_contatos   a API; CRUD no schema orbita, sujeito a RLS
#   importacao_svc o worker; só o schema importacao, nada em orbita
DB_SENHA_MIGRADOR=exemplo_migrador_troque
DB_SENHA_API=exemplo_api_troque
DB_SENHA_IMPORTACAO=exemplo_importacao_troque

DATABASE_URL_MIGRADOR=postgres://migrador:exemplo_migrador_troque@postgres:5432/orbitati
DATABASE_URL_API=postgres://api_contatos:exemplo_api_troque@postgres:5432/orbitati
DATABASE_URL_IMPORTACAO=postgres://importacao_svc:exemplo_importacao_troque@postgres:5432/orbitati

REDIS_URL=redis://redis:6379

# Segredo dos tokens de usuário (HS256). Pelo menos 32 caracteres.
JWT_SEGREDO=exemplo_jwt_usuario_troque_por_32_caracteres_ou_mais
# Segredo SEPARADO do token de serviço (worker -> API, regra 7). Vazar um não compromete o outro.
JWT_SERVICO_SEGREDO=exemplo_jwt_servico_troque_por_32_caracteres_ou_mais

# Endereço da API dentro da rede do compose (o worker chama /interno por aqui).
API_URL_INTERNA=http://api-contatos:3000

# Worker de importação (ADR-003): linhas por lote e pausa entre lotes. Os padrões são os do projeto
# (100 e 500 ms). O teste de carga (bloco 9) troca os dois para comparar com e sem a mitigação.
IMPORT_LOTE=100
IMPORT_PAUSA_MS=500
